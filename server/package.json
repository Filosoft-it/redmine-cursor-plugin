{
  "name": "@filosoft/redmine-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Redmine issues, projects, and REST filters used by the Redmine Cursor plugin",
  "type": "module",
  "bin": {
    "redmine-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:bundle",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/client.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "redmine",
    "mcp",
    "cursor",
    "model-context-protocol"
  ],
  "author": "Filosoft",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.5",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
